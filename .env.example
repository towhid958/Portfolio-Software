# Copy this file to .env and fill in real values for local development.
# .env is gitignored - never commit real values.
#
# Get these from your Supabase project: Dashboard -> Project Settings -> API.
# Both are safe to expose client-side (protected by row-level security).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_PROJECT_ID=your-project-ref

# Same values, mirrored with the VITE_ prefix Vite requires to expose them
# to client-side code.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Your deployed site's URL. Used to build absolute links in emails and
# Stripe checkout redirects. Falls back to http://localhost:8080 if unset.
FRONTEND_URL=http://localhost:8080

# --- Secrets: do NOT put these in .env. Put them in .dev.vars instead ---
# (.dev.vars is gitignored and is what Wrangler/Nitro load server-side.)
#
# SUPABASE_SERVICE_ROLE_KEY  - Dashboard -> Project Settings -> API (service_role, secret)
# STRIPE_SECRET_KEY          - Stripe Dashboard -> Developers -> API keys
# STRIPE_WEBHOOK_SECRET      - Stripe Dashboard -> Developers -> Webhooks -> your endpoint
# RESEND_API_KEY             - Resend Dashboard -> API Keys
# SENDER_EMAIL                - the "from" address used for transactional emails
